<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>仪表盘 - KARDS</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .admin-container { max-width: 1200px; margin: 0 auto; padding: 20px; font-family: system-ui; }
    .admin-nav { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 20px; }
    .admin-nav a { margin-left: 20px; color: #4a6cf7; text-decoration: none; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin: 20px 0; }
    .stat-card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .alert { background: #fff3e0; padding: 15px; border-radius: 8px; border-left: 4px solid #e65100; margin: 20px 0; }
  </style>
</head>
<body>
<div class="admin-container">
  <nav class="admin-nav">
    <h2>📊 KARDS 后台</h2>
    <div>
      <a href="/admin/dashboard">仪表盘</a>
      <a href="/admin/tags">标签管理</a>
      <a href="/admin/materials">素材管理</a>
      <a href="/admin/logout">退出</a>
    </div>
  </nav>
  <div class="admin-content">
    <h3>系统概览</h3>
    <div class="stats-grid">
      <div class="stat-card">📸 素材总数 <strong><%= totalMaterials %></strong></div>
      <div class="stat-card">⚠️ 未分类 <strong style="color:#e65100;"><%= uncategorized %></strong></div>
      <div class="stat-card">🏷️ 标签总数 <strong><%= totalTags %></strong></div>
    </div>
    <h4>标签分类统计</h4>
    <ul>
      <% categoryStats.forEach(c => { %>
        <li><%= c.name %>：<%= c.tag_count %> 个标签</li>
      <% }) %>
    </ul>
    <% if (uncategorized > 0) { %>
      <div class="alert">⚠️ 有 <%= uncategorized %> 个素材未分类，<a href="/admin/materials?filter=uncategorized">点击查看</a></div>
    <% } %>
  </div>
</div>
</body>
</html>